# Helpdesk Agent environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real credentials.

# --- LLM (Bedrock AgentCore gateway / OpenAI-compatible SDK) ---
# REQUIRED: the app fails to start without this
HELPDESK_AGENT_LLM_API_KEY=your-gateway-auth-token

# Optional LLM settings
# Use a plain model ID or a target-qualified model ID like openai/gpt-5.5
HELPDESK_AGENT_LLM_MODEL=openai/gpt-5.5
# Example Bedrock gateway endpoint: https://<gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/inference/v1
# HELPDESK_AGENT_LLM_BASE_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/inference/v1
HELPDESK_AGENT_LLM_TIMEOUT_SECONDS=30.0

# --- Triage thresholds ---
HELPDESK_AGENT_TRIAGE_CONFIDENCE_THRESHOLD=0.6
HELPDESK_AGENT_FAQ_RELEVANCE_THRESHOLD=0.7

# --- MCP integration ---
# Set to 1 to enable real MCP tool calls (Gmail, Jira, Slack, FAQ)
HELPDESK_AGENT_USE_MCP=0
HELPDESK_AGENT_MCP_BASE_URL=http://127.0.0.1:8765/mcp
HELPDESK_AGENT_MCP_ATLASSIAN_URL=http://host.docker.internal:8000
HELPDESK_AGENT_MCP_TIMEOUT_SECONDS=5.0
# HELPDESK_AGENT_MCP_AUTH_TOKEN=your-bearer-token

# --- A2A (Agent2Agent) ---
# Public base URL advertised in the Agent Card.
HELPDESK_AGENT_A2A_BASE_URL=http://localhost:8080
HELPDESK_AGENT_A2A_AGENT_NAME=helpdesk-agent
HELPDESK_AGENT_A2A_TIMEOUT_SECONDS=30.0
# Optional remote agents as a JSON object: {"agent-name": "http://agent-host:port"}
HELPDESK_AGENT_A2A_REMOTE_AGENTS={}

# --- Server ---
PORT=8080

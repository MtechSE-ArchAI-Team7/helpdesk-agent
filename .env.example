# Helpdesk Agent environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real credentials.

# --- LLM (Bedrock AgentCore gateway / OpenAI-compatible SDK) ---
# REQUIRED: the app fails to start without this
HELPDESK_AGENT_LLM_API_KEY=your-gateway-auth-token

# Optional LLM settings
# Use a plain model ID or a target-qualified model ID like openai/gpt-5.5
HELPDESK_AGENT_LLM_MODEL=openai/gpt-5.5
# Example Bedrock gateway endpoint: https://<gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/inference/v1
# HELPDESK_AGENT_LLM_BASE_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/inference/v1
HELPDESK_AGENT_LLM_TIMEOUT_SECONDS=30.0

# --- Triage thresholds ---
HELPDESK_AGENT_TRIAGE_CONFIDENCE_THRESHOLD=0.6
HELPDESK_AGENT_FAQ_RELEVANCE_THRESHOLD=0.7

# --- MCP integration ---
# Set to 1 to enable real MCP tool calls (Zoho Mail, Jira, FAQ, Playwright)
HELPDESK_AGENT_USE_MCP=0
# Default MCP server, used by any tool without a dedicated URL below
HELPDESK_AGENT_MCP_BASE_URL=http://127.0.0.1:8765/mcp
# Zoho Mail MCP server: zohomail.* tools (sendEmail, sendReplyEmail, listEmails,
# getMailAccounts)
HELPDESK_AGENT_MCP_ZOHOMAIL_URL=http://127.0.0.1:9000/mcp
# Zoho tool name prefix used by the server (default matches Zoho's own server)
HELPDESK_AGENT_MCP_ZOHOMAIL_TOOL_PREFIX=ZohoMail_
# Helpdesk mailbox address — required as fromAddress on Zoho sends/replies
HELPDESK_AGENT_ZOHOMAIL_FROM_ADDRESS=helpdesk@yourdomain.com
# FAQ MCP server: faq.search
HELPDESK_AGENT_MCP_FAQ_URL=http://127.0.0.1:9001/mcp
# Set to your managed Knowledge Base gateway target prefix to call Retrieve.
# Unset preserves legacy faq.search; empty calls unprefixed Retrieve.
# Configure numberOfResults on the managed connector target in AWS.
# HELPDESK_AGENT_MCP_FAQ_TOOL_PREFIX=your-knowledge-target___
# mcp-atlassian server: all jira.* / confluence.* tools are routed here
HELPDESK_AGENT_MCP_ATLASSIAN_URL=http://host.docker.internal:8000
# Optional hosted Playwright MCP runtime endpoint. Configure the existing
# AgentCore runtime endpoint here; the helpdesk agent does not deploy it.
# HELPDESK_AGENT_MCP_PLAYWRIGHT_URL=https://<playwright-runtime-endpoint>/mcp
# Gateway tool target prefix. Override for your target name; use empty for a
# direct connection to the Playwright MCP server without gateway namespacing.
HELPDESK_AGENT_MCP_PLAYWRIGHT_TOOL_PREFIX=mcp-playwright___
HELPDESK_AGENT_MCP_PLAYWRIGHT_TIMEOUT_SECONDS=30.0
# Exact approved application hostnames only; no scheme, port, or wildcard.
# Browser validation requires an explicit HTTP(S) URL from the user's report.
# HTTP is unencrypted; prefer HTTPS and never submit credentials.
# HELPDESK_AGENT_PLAYWRIGHT_ALLOWED_HOSTS=portal.yourdomain.com
HELPDESK_AGENT_MCP_TIMEOUT_SECONDS=5.0
# HELPDESK_AGENT_MCP_AUTH_TOKEN=your-bearer-token
# Prefix prepended to mcp-atlassian tool names (e.g. "atlassian_" behind a gateway)
# HELPDESK_AGENT_MCP_TOOL_PREFIX=
# Jira project key: used when creating issues AND to detect ticket IDs like
# [HELP-123] in incoming email subjects (existing-ticket path)
HELPDESK_AGENT_JIRA_PROJECT_KEY=HELP

# --- A2A (Agent2Agent) ---
# Public base URL advertised in the Agent Card.
HELPDESK_AGENT_A2A_BASE_URL=http://localhost:8080
HELPDESK_AGENT_A2A_AGENT_NAME=helpdesk-agent
HELPDESK_AGENT_A2A_TIMEOUT_SECONDS=30.0
# Optional remote agents as a JSON object: {"agent-name": "http://agent-host:port"}
HELPDESK_AGENT_A2A_REMOTE_AGENTS={}

# --- Diagnosis agent (Agent 2) hand-off ---
# The diagnose workflow node escalates unresolved cases to the diagnosis agent,
# fire-and-forget; the diagnosis agent posts results to the Jira ticket itself.
# LOCAL DEV: point at the diagnosis agent's base URL and use its AGENT_AUTH_TOKEN.
HELPDESK_AGENT_A2A_REMOTE_AGENTS={"diagnosis-agent": "http://localhost:9000"}
HELPDESK_AGENT_A2A_REMOTE_AGENT_TOKENS={"diagnosis-agent": "your-diagnosis-agent-auth-token"}
# DEPLOYED (AgentCore): set the runtime ARN instead of/in addition to the URL —
# an ARN selects the SigV4-signed InvokeAgentRuntime transport over direct HTTP.
# The token above stays REQUIRED on the AgentCore path: it is sent on the
# X-Amzn-Bedrock-AgentCore-Runtime-Custom-Authorization header (Authorization
# itself is consumed by the SigV4 signature). The token VALUE lives in Secrets
# Manager as aios/diagnosis-agent/agent-auth-token (account 734849394833).
# Two ways to supply it:
#  1. HELPDESK_AGENT_A2A_REMOTE_AGENT_TOKENS with the literal token value
#     (local dev / deployment-time injection from Secrets Manager), or
#  2. HELPDESK_AGENT_A2A_REMOTE_AGENT_TOKEN_SECRET_ARNS with the secret ARN
#     (or name) — the agent resolves it via GetSecretValue at startup under
#     its execution role, which then needs secretsmanager:GetSecretValue on it.
#     A literal token set for the same agent takes precedence.
# Also grant this agent's execution role bedrock-agentcore:InvokeAgentRuntime
# scoped to the diagnosis runtime ARN.
# HELPDESK_AGENT_A2A_REMOTE_AGENT_TOKEN_SECRET_ARNS={"diagnosis-agent": "arn:aws:secretsmanager:ap-southeast-1:734849394833:secret:aios/diagnosis-agent/agent-auth-token"}
# HELPDESK_AGENT_A2A_REMOTE_AGENT_ARNS={"diagnosis-agent": "arn:aws:bedrock-agentcore:ap-southeast-1:734849394833:runtime/diagnosis_agent-GpDELMCxll"}
# HELPDESK_AGENT_A2A_AGENTCORE_REGION=ap-southeast-1

# --- Server ---
PORT=8080
# Log level for helpdesk_agent stage logs (DEBUG, INFO, WARNING, ERROR)
HELPDESK_AGENT_LOG_LEVEL=INFO
